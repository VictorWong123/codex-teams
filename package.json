{
  "name": "codex-teams",
  "version": "0.1.5-rc.1",
  "type": "module",
  "bin": {
    "cteam": "src/cli.js",
    "codex-teams": "src/cli.js",
    "codex-teams-mcp": "src/mcp.js"
  },
  "scripts": {
    "start": "node src/service.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.mjs",
    "install:user": "bash scripts/install.sh",
    "uninstall:user": "bash scripts/uninstall.sh",
    "self-test": "node src/cli.js self-test",
    "verify:install": "node scripts/verify-install.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "description": "Local persistent Codex agent teams with a CLI, MCP server and dashboard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VictorWong123/codex-teams.git"
  },
  "files": [
    "src/",
    "public/",
    "scripts/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "PROTOCOL.md",
    "protocol/",
    "VALIDATION.md",
    "plugins/",
    "CLOUD.md",
    "RELEASE_CHECKLIST.md"
  ],
  "keywords": [
    "codex",
    "mcp",
    "teams",
    "agents"
  ],
  "homepage": "https://github.com/VictorWong123/codex-teams#readme",
  "bugs": {
    "url": "https://github.com/VictorWong123/codex-teams/issues"
  }
}
